# =====================================================
# ПРИМЕР ФАЙЛА ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# =====================================================
# Скопируй этот файл в .env и заполни своими данными:
# cp .env.example .env
# =====================================================

# ===================
# БАЗА ДАННЫХ
# ===================
# Для Docker используй db вместо localhost
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_STRONG_PASSWORD_HERE@localhost:5432/finance_app
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=finance_app

# ===================
# БЕЗОПАСНОСТЬ
# ===================
# ВАЖНО: Измени на свой секретный ключ в продакшене!
# Сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================
# Т-БАНК API
# ===================
# Получи токен на https://www.tbank.ru/api/
# Для тестов используй sandbox токен
TBANK_TOKEN=your_tbank_api_token_here
TBANK_ENCRYPTION_KEY=your_tbank_encription_key_here
TBANK_SANDBOX=true

# ===================
# EMAIL УВЕДОМЛЕНИЯ
# ===================
# Для Gmail нужен "App Password", не обычный пароль!
# https://support.google.com/accounts/answer/185833
# ⚠️ Используйте пароль приложения, не основной пароль!
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=

# ===================
# КУРСЫ ВАЛЮТ API
# ===================
# Бесплатный ключ: https://exchangeratesapi.io/
# Или https://www.exchangerate-api.com/
EXCHANGE_RATES_API_KEY=your_exchange_rates_api_key

# ===================
# РЕЖИМ РАБОТЫ
# ===================
# development / production
ENVIRONMENT=development
DEBUG=false

# ===================
# ФРОНТЕНД
# ===================
# URL бэкенда для фронтенда
VITE_API_URL=http://localhost:8000/api/v1

# Разработка
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Продакшен (пример)
# ALLOWED_ORIGINS=https://your-domain.com