# =====================================================
# ПРИМЕР ФАЙЛА ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# =====================================================
# Скопируй этот файл в .env и заполни своими данными:
# cp .env.example .env
# =====================================================

# ===================
# БАЗА ДАННЫХ
# ===================
# Для Docker используй db вместо localhost
DATABASE_URL=postgresql://finance_user:1029384756Aa@localhost:5432/finance_app
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=1029384756Aa
POSTGRES_DB=finance_app

# ===================
# БЕЗОПАСНОСТЬ
# ===================
# ВАЖНО: Измени на свой секретный ключ в продакшене!
# Сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-very-long-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================
# Т-БАНК API
# ===================
# Получи токен на https://www.tbank.ru/api/
# Для тестов используй sandbox токен
TBANK_TOKEN=your_tbank_api_token_here
TBANK_SANDBOX=true

# ===================
# EMAIL УВЕДОМЛЕНИЯ
# ===================
# Для Gmail нужен "App Password", не обычный пароль!
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# ===================
# КУРСЫ ВАЛЮТ API
# ===================
# Бесплатный ключ: https://exchangeratesapi.io/
# Или https://www.exchangerate-api.com/
EXCHANGE_RATES_API_KEY=your_exchange_rates_api_key

# ===================
# РЕЖИМ РАБОТЫ
# ===================
# development / production
ENVIRONMENT=development
DEBUG=true

# ===================
# ФРОНТЕНД
# ===================
# URL бэкенда для фронтенда
VITE_API_URL=http://localhost:8000/api/v1
