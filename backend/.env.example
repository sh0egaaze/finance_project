# База данных PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/finance_app

# JWT настройки
# JWT конфигурация
# Сгенерируйте надёжный ключ: python -c "import secrets; print(secrets.token_hex(32))"
# НЕ используйте значение ниже в продакшене!
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Т-Банк API
TBANK_API_URL=https://business.tbank.ru/openapi
TBANK_TOKEN=your-tbank-token
TBANK_ENCRYPTION_KEY=your-encryption-key

# API курсов валют (например, exchangerate-api.com)
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest
CURRENCY_API_KEY=your-currency-api-key

# Email конфигурация (опционально, для напоминаний)
# ⚠️ Используйте пароль приложения, не основной пароль!
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=

# Настройки приложения
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
