# База данных PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/finance_app

# JWT настройки
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Т-Банк API
TBANK_API_URL=https://business.tbank.ru/openapi
TBANK_TOKEN=your-tbank-token

# API курсов валют (например, exchangerate-api.com)
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest
CURRENCY_API_KEY=your-currency-api-key

# Email настройки (для напоминаний)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Настройки приложения
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
